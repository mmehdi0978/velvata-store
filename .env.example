# --- Database (SQLite file, created automatically) ---
DATABASE_URL="file:./dev.db"

# --- First admin account (used ONLY by `npm run db:seed`; change password after first login) ---
ADMIN_EMAIL="admin@store.pk"
ADMIN_PASSWORD="admin123"

# --- Google + Facebook login for ADMIN panel (optional) ---
# After creating the OAuth apps (see OAUTH-SETUP.md), paste the credentials here
# AND in cPanel "Setup Node.js App" environment variables, then restart the app.
# Only the ADMIN_EMAIL account can sign in via Google/Facebook — everyone else
# is rejected. If these are empty, the social buttons simply don't appear.
# Redirect URIs to register in the OAuth consoles:
#   https://erzo.me/api/auth/callback/google
#   https://erzo.me/api/auth/callback/facebook
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Random secret for signing auth cookies — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://erzo.me"

# --- JazzCash (sandbox placeholders — replace with real merchant credentials to go live) ---
# Get real credentials from your JazzCash merchant account (https://www.jazzcash.com.pk)
# These can also be set/overridden from the Admin Panel → Settings page.
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# true = use JazzCash sandbox endpoints, false = live endpoints
JAZZCASH_SANDBOX="true"
# true = simulate the JazzCash payment screen locally (for testing checkout end-to-end
# without real credentials). Set to "false" to call the real JazzCash API.
JAZZCASH_DEMO_MODE="true"
# Where JazzCash posts the payment result back (must be publicly reachable in live mode)
JAZZCASH_RETURN_URL="http://localhost:3000/api/payments/jazzcash/callback"

# --- WhatsApp (owner's number in international format, no + or spaces; also editable in admin) ---
STORE_WHATSAPP="923001234567"

# --- Store ---
STORE_NAME="Libaas Collection"

# Email alerts for new orders (via cPanel email account SMTP)
SMTP_HOST="mail.tarm.foo"
SMTP_PORT="465"
SMTP_USER="admin@tarm.foo"
SMTP_PASS=""
ALERT_EMAIL="admin@tarm.foo"

# --- AI Chatbot (Gemini) ---
# Get a FREE API key from https://aistudio.google.com/apikey
# Paste it here AND in cPanel environment variables, then restart the app.
# Without this key, the chat widget shows a "not set up" message.
GEMINI_API_KEY=""
